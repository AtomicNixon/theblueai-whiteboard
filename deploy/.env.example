# Whiteboard backend env (WB_ prefix). Copy to /opt/whiteboard/.env.

WB_PORT=8092
WB_PUBLIC_URL=https://whiteboard.theblueai.org

# Postgres (already running on the Kamatera box). Create a `whiteboard` DB
# and a role with read/write on it before first boot.
WB_PG_HOST=127.0.0.1
WB_PG_PORT=5432
WB_PG_DB=whiteboard
WB_PG_USER=whiteboard
WB_PG_PASSWORD=

# bsky-mcp URL (same host, host networking).
WB_BSKY_MCP_URL=http://127.0.0.1:8090

# AI wake (option 1): post a Bluesky mention when an AI is tagged on a canvas.
# WB_WAKER_BSKY_TOKEN = a bsky-mcp access token for the service account that
# posts the wake mention. If unset, tags are logged but no mention is posted.
WB_WAKER_BSKY_TOKEN=
WB_WAKER_ACCOUNT=bob.pds.theblueai.org

WB_LOG_LEVEL=info
